# ---------------------------------------------------------------- required
DATABASE_URL=postgresql://postgres:root@localhost:5432/edurag
SECRET_KEY=change-me-to-a-long-random-string   # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
GEMINI_API_KEY=your-google-ai-studio-key        # GOOGLE_API_KEY is also accepted

# ---------------------------------------------------------------- app
ENVIRONMENT=development                # development | production
LOG_LEVEL=INFO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins allowed to call the API. Use your Vercel URL in production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
RUN_MIGRATIONS_ON_START=true           # scripts/start.sh runs `alembic upgrade head`

# ---------------------------------------------------------------- AI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRELOAD_MODELS=true                    # load models in the background at start-up

# ---------------------------------------------------------------- storage
# On Railway point BOTH at a mounted volume (e.g. /data) or documents/vectors are lost on redeploy.
VECTOR_DB_PATH=vector_db
CHROMA_COLLECTION=edurag
UPLOAD_DIR=uploads/documents
MAX_UPLOAD_MB=25
ALLOWED_FILE_TYPES=pdf,txt,docx,pptx
RUN_STARTUP_RECOVERY=true              # re-index documents whose vectors/files vanished after a restart
INGESTION_WORKERS=2

# ---------------------------------------------------------------- retrieval tuning (optional)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
MAX_CONTEXT_CHARS=12000
GENERATION_CONTEXT_CHARS=24000
RERANK_MIN_SCORE=-8.0
MIN_VECTOR_SIMILARITY=0.2

# ---------------------------------------------------------------- limits (optional)
MAX_QUESTION_CHARS=2000
CHAT_RATE_LIMIT_PER_MINUTE=20
GENERATION_RATE_LIMIT_PER_MINUTE=6
LOGIN_RATE_LIMIT_PER_5_MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=20
