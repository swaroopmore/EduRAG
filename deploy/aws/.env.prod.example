# Copy to .env.prod on the server. NEVER commit .env.prod.
ENVIRONMENT=production
LOG_LEVEL=INFO

# Public HTTPS hostname of the API (must already point at the server's Elastic IP).
# No domain? Use  <ELASTIC-IP-with-dashes>.sslip.io   e.g.  3-90-12-34.sslip.io
API_DOMAIN=api.example.com

# Amazon RDS Postgres. RDS requires SSL, so keep ?sslmode=require.
# Use a password made only of letters and digits (special characters need URL-encoding).
DATABASE_URL=postgresql://edurag:CHANGE_ME@your-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/edurag?sslmode=require

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
GEMINI_API_KEY=CHANGE_ME

# The exact origin(s) of the frontend (CloudFront URL or your domain), no trailing slash.
CORS_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net

RUN_MIGRATIONS_ON_START=true
RUN_STARTUP_RECOVERY=true
CHROMA_COLLECTION=edurag
